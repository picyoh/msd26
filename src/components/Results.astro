---
import { RotateCcw, ExternalLink, Star, ChevronLeft, ChevronRight } from 'lucide-react';

interface ResultsProps {
  results: string[];
  onRestart: () => void;
}

interface Mouse {
  name: string;
  brand: string;
  image: string;
  price: string;
  match: number;
  features: string[];
  link: string;
}
---
<div class="container mx-auto px-4 py-12 max-w-6xl">
      <div class="text-center mb-12">
        <h2 class="text-4xl font-bold mb-4 bg-gradient-to-r from-blue-400 via-purple-500 to-pink-500 text-transparent bg-clip-text">
          Vos Recommandations
        </h2>
        <p class="text-gray-400 text-lg">
          Basées sur votre profil, voici les souris qui correspondent le mieux à vos besoins
        </p>
      </div>

      <div class="relative mb-12">
        <button
        id="prevButton"
          class="absolute left-0 top-1/2 -translate-y-1/2 -translate-x-16 z-10 p-3 rounded-full hover:bg-white/10 transition-colors"
          aria-label="Précédent"
        >
          <ChevronLeft size={28} class="text-blue-400" />
        </button>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 px-4">
          {getVisibleIndices().map((index) => {
            const mouse = mice[index];
            const isCenter = index === currentIndex;

            return (
              <div
                key={index}
                class={`transition-all duration-300 ${
                  isCenter ? 'md:scale-110 md:z-20' : 'md:opacity-60'
                }`}
              >
                <div
                  class={`rounded-xl overflow-hidden backdrop-blur-lg border transition-all duration-300 ${
                    isCenter
                      ? 'bg-gradient-to-br from-blue-500/20 to-purple-600/20 border-blue-400/50 shadow-2xl shadow-blue-500/20'
                      : 'bg-white/5 border-white/10 hover:bg-white/10'
                  }`}
                >
                  <div class="relative">
                    <img
                      src={mouse.image}
                      alt={mouse.name}
                      class="w-full h-48 object-cover"
                    />
                    <div class={`absolute top-4 right-4 px-3 py-1 rounded-full flex items-center gap-1 ${
                      isCenter
                        ? 'bg-gradient-to-r from-blue-400 to-pink-500'
                        : 'bg-gradient-to-r from-blue-500 to-purple-600'
                    }`}>
                      <Star size={16} fill="currentColor" />
                      <span class="font-bold">{mouse.match}%</span>
                    </div>
                  </div>

                  <div class="p-6">
                    <div class="mb-2">
                      <span class="text-sm text-gray-400">{mouse.brand}</span>
                      <h3 class={`font-bold mb-2 ${isCenter ? 'text-2xl' : 'text-xl'}`}>
                        {mouse.name}
                      </h3>
                    </div>

                    <div class="mb-4">
                      <span class={`font-bold ${isCenter ? 'text-3xl' : 'text-2xl'} text-blue-400`}>
                        {mouse.price}
                      </span>
                    </div>

                    <ul class={`space-y-2 mb-6 ${!isCenter && 'hidden md:block'}`}>
                      {mouse.features.map((feature, idx) => (
                        <li key={idx} class="text-sm text-gray-300 flex items-start">
                          <span class="text-blue-400 mr-2">•</span>
                          {feature}
                        </li>
                      ))}
                    </ul>

                    <a
                      href={mouse.link}
                      class={`w-full flex items-center justify-center gap-2 px-4 py-3 rounded-lg transition-all ${
                        isCenter
                          ? 'bg-gradient-to-r from-blue-500 to-pink-500 hover:opacity-90 text-white'
                          : 'bg-gradient-to-r from-blue-500 to-purple-600 hover:opacity-90'
                      }`}
                    >
                      Voir les offres
                      <ExternalLink size={16} />
                    </a>
                  </div>
                </div>
              </div>
            );
          })}
        </div>

        <button
        id="nextButton"
          class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-16 z-10 p-3 rounded-full hover:bg-white/10 transition-colors"
          aria-label="Suivant"
        >
          <ChevronRight size={28} class="text-blue-400" />
        </button>
      </div>

      <div class="text-center">
        <button
        id="restartButton"  
        class="inline-flex items-center gap-2 px-8 py-4 rounded-lg border border-gray-600 hover:bg-white/5 transition-colors"
        >
          <RotateCcw size={20} />
          Recommencer le quiz
        </button>
      </div>
    </div>
  );

<script>

const prevButton = document.querySelector("#prevButton");
const nextButton = document.querySelector("#nextButton");
const restartButton = document.querySelector("#restartButton");



function Results({ results, onRestart }: ResultsProps) {
  const getRecommendedMice = (): Mouse[] => {
  const isGaming = results[0] === "a";
  const frequency = results[1];
  const usage = results[2];
  const mice = getRecommendedMice();
  const [currentIndex, setCurrentIndex] = useState(Math.floor(mice.length / 2));

  const handlePrev = () => {
    setCurrentIndex((prev) => (prev === 0 ? mice.length - 1 : prev - 1));
  };

  const handleNext = () => {
    setCurrentIndex((prev) => (prev === mice.length - 1 ? 0 : prev + 1));
  };

  const getVisibleIndices = () => {
    const indices = [];
    const itemsToShow = window.innerWidth < 768 ? 1 : 3;
    const halfItems = Math.floor(itemsToShow / 2);

    for (let i = -halfItems; i <= halfItems; i++) {
      indices.push((currentIndex + i + mice.length) % mice.length);
    }
    return indices;
  };
};
};
</script>